# orch configuration - copy to ~/.orch/orchd.env (or /etc/orchd.env).
# `orchd setup` generates this file interactively.

# ── Agent backend ─────────────────────────────────────────────────────────
# Which agent runs your workers: claude | codex | gemini | api | custom
ORCH_AGENT=claude

# api backend (no CLI needed - raw keys):
#ORCH_API_PROVIDER=anthropic          # anthropic | openai (any OpenAI-compatible)
#ORCH_API_KEY=sk-...
#ORCH_API_MODEL=claude-sonnet-5       # required for openai-compatible providers
#ORCH_API_BASE_URL=                   # e.g. http://localhost:11434/v1 for Ollama

# custom backend (any agent CLI; {mission_id}/{directive} are substituted):
#ORCH_CUSTOM_FIRST_CMD=myagent --new {mission_id} -p {directive}
#ORCH_CUSTOM_RESUME_CMD=myagent --continue {mission_id} -p {directive}

# per-CLI overrides:
#ORCH_CLAUDE_BIN=claude
#ORCH_CODEX_BIN=codex
#ORCH_GEMINI_BIN=gemini
#ORCH_GEMINI_RESUME_ARGS=--resume latest
# Gemini CLI headless auth: Google retired the CLI's free login tier, so set an
# API key (aistudio.google.com/apikey) - orch forwards it to gemini workers.
#GEMINI_API_KEY=

# ── Telegram ──────────────────────────────────────────────────────────────
# Command bot (from @BotFather): inbound /commands + worker notify replies.
ORCH_HOST_BOT_TOKEN=
# Comma-separated chat ids allowed to command the daemon (your DM chat id).
ORCH_HOST_ALLOWED_CHAT_IDS=
# Default chat for worker notifications (usually the same DM id).
ORCH_DEFAULT_CHAT_ID=
# Optional forum supergroup: one Telegram Topic per mission. The bot must be
# an admin there with Manage Topics. Creating a topic spawns a mission.
#ORCH_TOPICS_CHAT_ID=
# Optional second bot used only as a legacy notification fallback.
#ORCH_TELEGRAM_BOT_TOKEN=

# ── Secrets vault (pass/GPG) ──────────────────────────────────────────────
ORCH_MASTER_PASSPHRASE=change-me

# ── Extra worker MCP servers (Claude/Codex/Gemini backends) ───────────────
# JSON file merged into every worker's MCP config; '{mission_id}' substituted.
#ORCH_EXTRA_WORKER_MCPS=/etc/orch/worker_mcp.json
