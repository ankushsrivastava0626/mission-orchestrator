{
  "mcpServers": {
    "orch": {
      "command": "ssh",
      "args": [
        "-o", "BatchMode=yes",
        "-o", "StrictHostKeyChecking=accept-new",
        "-o", "ServerAliveInterval=30",
        "-o", "ServerAliveCountMax=3",
        "-o", "ConnectTimeout=10",
        "root@107.170.18.216",
        "/usr/local/bin/orch-mcp", "--mode", "host"
      ]
    }
  }
}
